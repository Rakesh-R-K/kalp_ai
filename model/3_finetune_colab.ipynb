   "metadata": {},
   "source": [
    "## Cell 5 — Load TinyLlama with 4-bit Quantization (QLoRA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
    "\n",
    "# Model to fine-tune\n",
    "BASE_MODEL = 'TinyLlama/TinyLlama-1.1B-Chat-v1.0'\n",
    "\n",
    "print(f'Loading {BASE_MODEL}...')\n",
    "\n",
    "# 4-bit quantization config (QLoRA)\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type='nf4',          # NormalFloat4 — best quality\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,      # Saves more VRAM\n",
    ")\n",
    "\n",
    "# Load model\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    BASE_MODEL,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map='auto',\n",
    "    trust_remote_code=True,\n",
    ")\n",
    "\n",
    "# Load tokenizer\n",
    "tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL, trust_remote_code=True)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "tokenizer.padding_side = 'right'\n",
    "\n",
    "# Prepare model for k-bit training\n",
    "model = prepare_model_for_kbit_training(model)\n",
    "\n",
    "print(f'✅ Model loaded!')\n",
    "print(f'   Parameters: {model.num_parameters()/1e9:.2f}B')\n",
    "\n",
    "# Check VRAM usage\n",
    "allocated = torch.cuda.memory_allocated() / 1e9\n",
    "print(f'   VRAM used: {allocated:.2f} GB')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6 — Apply LoRA Adapters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from peft import LoraConfig, get_peft_model, TaskType\n",
    "\n",
    "# LoRA config — adds trainable adapters to attention layers\n",
    "# Only ~1% of parameters will be trained!\n",
    "lora_config = LoraConfig(\n",
    "    task_type=TaskType.CAUSAL_LM,\n",
    "    r=16,                          # LoRA rank (higher = more capacity, more VRAM)\n",
    "    lora_alpha=32,                 # Scaling factor (usually 2x rank)\n",
    "    lora_dropout=0.05,             # Regularization\n",
    "    bias='none',\n",
    "    target_modules=[               # Which layers to apply LoRA to\n",
    "        'q_proj', 'k_proj', 'v_proj', 'o_proj',\n",
    "        'gate_proj', 'up_proj', 'down_proj',\n",
    "    ],\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, lora_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7 — Configure Training & Train!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from transformers import TrainingArguments\n",
    "from trl import SFTTrainer\n",
    "\n",
    "# Create output directory\n",
    "os.makedirs(MODEL_SAVE_PATH, exist_ok=True)\n",
    "\n",
    "# Training arguments — tuned for T4 15GB VRAM\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=MODEL_SAVE_PATH,\n",
    "    num_train_epochs=3,              # 3 passes over your data\n",
    "    per_device_train_batch_size=2,   # Small batch (limited VRAM)\n",
    "    gradient_accumulation_steps=8,   # Effective batch = 2 * 8 = 16\n",
    "    gradient_checkpointing=True,     # Trade compute for VRAM savings\n",
    "    optim='paged_adamw_32bit',       # Memory-efficient optimizer\n",
    "    learning_rate=2e-4,              # QLoRA recommended LR\n",
    "    lr_scheduler_type='cosine',      # Cosine decay\n",
    "    warmup_ratio=0.05,               # 5% warmup steps\n",
    "    fp16=True,                       # Use float16 precision\n",
    "    logging_steps=10,\n",
    "    save_strategy='steps',\n",
    "    save_steps=100,                  # Save checkpoint every 100 steps\n",
    "    save_total_limit=3,              # Keep only last 3 checkpoints (saves Drive space)\n",
    "    evaluation_strategy='no',        # Skip eval for speed (enable if you have val set)\n",
    "    report_to='none',                # Set to 'wandb' if you want loss tracking\n",
    "    dataloader_num_workers=2,\n",
    "    group_by_length=True,            # Batch similar-length sequences together (faster)\n",
    "    max_grad_norm=0.3,               # Gradient clipping\n",
    "    weight_decay=0.001,\n",
    ")\n",
    "\n",
    "# SFTTrainer — handles tokenization and formatting automatically\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=dataset,\n",
    "    dataset_text_field='text',       # Column with the formatted text\n",
    "    tokenizer=tokenizer,\n",
    "    max_seq_length=1024,             # Context window (1024 tokens)\n",
    "    packing=True,                    # Pack multiple short examples into one sequence (faster!)\n",
    ")\n",
    "\n",
    "print('🚀 Starting training...')\n",
    "print(f'   Dataset size: {len(dataset)} examples')\n",
    "print(f'   Epochs: {training_args.num_train_epochs}')\n",
    "print(f'   Batch size: {training_args.per_device_train_batch_size} × {training_args.gradient_accumulation_steps} steps = {training_args.per_device_train_batch_size * training_args.gradient_accumulation_steps} effective')\n",
    "print(f'   Saving to: {MODEL_SAVE_PATH}')\n",
    "print()\n",
    "\n",
    "trainer.train()\n",
    "\n",
    "print('\\n✅ Training complete!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8 — Save the Fine-tuned Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the LoRA adapter weights (small files — just the trained delta)\n",
    "adapter_path = os.path.join(MODEL_SAVE_PATH, 'final_adapter')\n",
    "trainer.model.save_pretrained(adapter_path)\n",
    "tokenizer.save_pretrained(adapter_path)\n",
    "\n",
    "print(f'✅ LoRA adapter saved to: {adapter_path}')\n",
    "print('   These are small files (~100MB). To use them:')\n",
    "print('   1. Load the base TinyLlama model')\n",
    "print('   2. Apply the adapter with PeftModel.from_pretrained()')\n",
    "\n",
    "# Optionally merge and save full model (larger but easier to use)\n",
    "MERGE_MODEL = True  # Set False if Drive space is limited\n",
    "\n",
    "if MERGE_MODEL:\n",
    "    from peft import PeftModel\n",
    "    from transformers import AutoModelForCausalLM\n",
    "\n",
    "    print('\\nMerging LoRA weights into base model...')\n",
    "    base = AutoModelForCausalLM.from_pretrained(\n",
    "        BASE_MODEL,\n",
    "        torch_dtype=torch.float16,\n",
    "        device_map='auto',\n",
    "    )\n",
    "    merged_model = PeftModel.from_pretrained(base, adapter_path)\n",
    "    merged_model = merged_model.merge_and_unload()\n",
    "\n",
    "    merged_path = os.path.join(MODEL_SAVE_PATH, 'merged_model')\n",
    "    merged_model.save_pretrained(merged_path)\n",
    "    tokenizer.save_pretrained(merged_path)\n",
    "    print(f'✅ Merged model saved to: {merged_path}')\n",
    "    print('   This is a standalone model (~2GB) you can run anywhere!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 9 — Test Your CTF Assistant!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import pipeline\n",
    "import torch\n",
    "\n",
    "# Load the fine-tuned model for inference\n",
    "pipe = pipeline(\n",
    "    'text-generation',\n",
    "    model=trainer.model,\n",
    "    tokenizer=tokenizer,\n",
    "    torch_dtype=torch.float16,\n",
    "    device_map='auto',\n",
    ")\n",
    "\n",
    "def ask_ctf_assistant(question: str, max_new_tokens: int = 512):\n",
    "    \"\"\"Query the fine-tuned CTF assistant.\"\"\"\n",
    "    prompt = f\"### Instruction:\\n{question}\\n\\n### Response:\\n\"\n",
    "    output = pipe(\n",
    "        prompt,\n",
    "        max_new_tokens=max_new_tokens,\n",
    "        do_sample=True,\n",
    "        temperature=0.7,\n",
    "        top_p=0.9,\n",
    "        repetition_penalty=1.15,\n",
    "    )\n",
    "    response = output[0]['generated_text']\n",
    "    # Extract just the response part\n",
    "    response = response.split('### Response:\\n')[-1].strip()\n",
    "    return response\n",
    "\n",
    "\n",
    "# ── Test queries ──────────────────────────────────────────────────────────────\n",
    "test_questions = [\n",
    "    \"How do I exploit a SQL injection vulnerability?\",\n",
    "    \"Write a Python script to scan open ports on a target host.\",\n",
    "    \"What is a ROP chain and how do I build one in a CTF?\",\n",
    "    \"How do I crack a hash in a CTF challenge?\",\n",
    "]\n",
    "\n",
    "for q in test_questions:\n",
    "    print(f'\\n{'─'*60}')\n",
    "    print(f'❓ {q}')\n",
    "    print(f'{'─'*60}')\n",
    "    answer = ask_ctf_assistant(q)\n",
    "    print(answer[:800])   # Print first 800 chars\n",
    "\n",
    "print(f'\\n{\"=\"*60}')\n",
    "print('🎉 Your CTF Security SLM is ready!')\n",
    "print(f'Model saved to: {MODEL_SAVE_PATH}')"
   ]
