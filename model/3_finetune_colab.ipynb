   "source": [
    "import json\n",
    "from datasets import Dataset, load_dataset\n",
    "\n",
    "# ── CONFIG — Edit these paths ─────────────────────────────────────\n",
    "USE_OWN_DATASET = False    # Set True if you have your own scraped data\n",
    "DATASET_PATH    = '/content/drive/MyDrive/ctf_slm/prepared_data/train_formatted.jsonl'\n",
    "MODEL_SAVE_PATH = '/content/drive/MyDrive/ctf_slm/model_checkpoints'\n",
    "# ──────────────────────────────────────────────────────────────────\n",
    "\n",
    "if USE_OWN_DATASET:\n",
    "    # Load your scraped dataset\n",
    "    data = []\n",
    "    with open(DATASET_PATH) as f:\n",
    "        for line in f:\n",
    "            data.append(json.loads(line.strip()))\n",
    "    dataset = Dataset.from_list(data)\n",
    "    print(f'✅ Loaded own dataset: {len(dataset)} examples')\n",
    "\n",
    "else:\n",
    "    # Option B: Use a pre-built security Q&A dataset from HuggingFace\n",
    "    # This is a good starting point even if you plan to use own data later\n",
    "    print('Loading pre-built security dataset from HuggingFace...')\n",
    "\n",
    "    # We'll use a general cybersecurity dataset and format it\n",
    "    raw = load_dataset('google/cybersecurity-awareness', split='train', trust_remote_code=True)\n",
    "\n",
    "    def format_hf_example(example):\n",
    "        text = f\"### Instruction:\\n{example.get('question', example.get('instruction', ''))}\\n\\n### Response:\\n{example.get('answer', example.get('output', ''))}\"\n",
    "        return {'text': text}\n",
    "\n",
    "    dataset = raw.map(format_hf_example)\n",
    "    print(f'✅ Loaded pre-built dataset: {len(dataset)} examples')\n",
    "\n",
    "print(f'\\nSample:')\n",
    "print(dataset[0]['text'][:400])"
   ]
